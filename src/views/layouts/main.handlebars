<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Tienda</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar navbar-dark bg-dark fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/">Mi Tienda</a>
            <div>
                <a class="btn btn-light btn-sm me-2" href="/products">Productos</a>
                <a class="btn btn-outline-light btn-sm me-2" href="/new-cart">Nuevo Carrito</a>
                {{#if cartId}}
                    <a class="btn btn-outline-light btn-sm" href="/carts/{{cartId}}">Mi Carrito</a>
                {{/if}}
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        {{{body}}}
    </div>

    <footer class="bg-dark text-white text-center py-3 mt-5">
        <p class="mb-0">© 2025 Tienda - Cantidades funcionando correctamente</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
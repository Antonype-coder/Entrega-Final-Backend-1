<h2 class="mb-4">Mi Carrito</h2>

{{#if cart.products.length}}
<div class="table-responsive">
    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Producto</th>
                <th>Precio</th>
                <th>Cantidad</th>
                <th>Total</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody>
            {{#each cart.products}}
            {{#if this.product}}
            <tr>
                <td>{{this.product.title}}</td>
                <td>${{this.product.price}}</td>
                <td>{{this.quantity}}</td>
                <td>${{multiply this.product.price this.quantity}}</td>
                <td>
                    <button onclick="deleteProduct('{{../cart._id}}', '{{this.product._id}}')" 
                            class="btn btn-danger btn-sm">Eliminar</button>
                </td>
            </tr>
            {{/if}}
            {{/each}}
        </tbody>
    </table>
</div>

<div class="d-flex justify-content-between align-items-center mt-4">
    <h4>Total: ${{total}}</h4>
    <div>
        <button onclick="clearCart('{{cart._id}}')" class="btn btn-outline-danger me-2">Vaciar Carrito</button>
        <a href="/products" class="btn btn-secondary me-2">Seguir Comprando</a>
        <a href="/new-cart" class="btn btn-info me-2">Nuevo Carrito</a>
        <button class="btn btn-success">Comprar</button>
    </div>
</div>
{{else}}
<div class="text-center py-5">
    <h3 class="text-muted">Carrito vacío</h3>
    <p class="text-muted">Tu carrito ID: {{cart._id}}</p>
    <div class="d-flex justify-content-center gap-2">
        <a href="/products" class="btn btn-primary">Ver Productos</a>
        <a href="/new-cart" class="btn btn-outline-primary">Crear Nuevo Carrito</a>
    </div>
</div>
{{/if}}

<script>
async function deleteProduct(cartId, productId) {
    if (!confirm('¿Eliminar este producto del carrito?')) return;
    
    try {
        const response = await fetch(`/api/carts/${cartId}/products/${productId}`, {
            method: 'DELETE'
        });
        
        const result = await response.json();
        
        if (result.status === 'success') {
            alert('Producto eliminado');
            location.reload();
        } else {
            alert('Error: ' + result.message);
        }
    } catch (error) {
        console.error('Error:', error);
        alert('Error al eliminar producto');
    }
}

async function clearCart(cartId) {
    if (!confirm('¿Vaciar todo el carrito?')) return;
    
    try {
        const response = await fetch(`/api/carts/${cartId}`, {
            method: 'DELETE'
        });
        
        const result = await response.json();
        
        if (result.status === 'success') {
            alert('Carrito vaciado');
            location.reload();
        } else {
            alert('Error: ' + result.message);
        }
    } catch (error) {
        console.error('Error:', error);
        alert('Error al vaciar carrito');
    }
}
</script>
<h2>Productos</h2>

<form class="row g-2 mb-3">
    <div class="col-md-4">
        <input type="text" name="query" class="form-control" placeholder="Buscar..." value="{{query}}">
    </div>
    <div class="col-md-3">
        <select name="sort" class="form-select">
            <option value="">Ordenar</option>
            <option value="asc" {{#if (eq sort "asc")}}selected{{/if}}>Precio: Bajo a Alto</option>
            <option value="desc" {{#if (eq sort "desc")}}selected{{/if}}>Precio: Alto a Bajo</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Filtrar</button>
    </div>
</form>

<div class="row">
    {{#each products}}
    <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
        <div class="card h-100">
            <img src="{{this.thumbnail}}" class="card-img-top" alt="{{this.title}}">
            <div class="card-body">
                <h5 class="card-title">{{this.title}}</h5>
                <p class="card-text text-muted small">{{this.description}}</p>
                <p class="card-text"><strong>${{this.price}}</strong></p>
                
                <div class="d-grid gap-2">
                    <a href="/products/{{this._id}}" class="btn btn-sm btn-outline-primary">Ver más</a>
                    
                    {{#if this.status}}
                    <form action="/api/carts/{{../cartId}}/products/{{this._id}}" method="POST" class="add-to-cart-form">
                        <div class="input-group input-group-sm">
                            <input type="number" name="quantity" value="1" min="1" max="{{this.stock}}" 
                                   class="form-control quantity-input" data-product-id="{{this._id}}">
                            <button class="btn btn-warning" type="submit">Agregar</button>
                        </div>
                    </form>
                    {{else}}
                    <button class="btn btn-secondary btn-sm" disabled>Agotado</button>
                    {{/if}}
                </div>
            </div>
        </div>
    </div>
    {{/each}}
</div>

{{#if totalPages}}
<nav class="mt-4">
    <ul class="pagination justify-content-center">
        {{#if hasPrevPage}}
        <li class="page-item"><a class="page-link" href="{{prevLink}}">Anterior</a></li>
        {{/if}}
        
        <li class="page-item disabled"><span class="page-link">Página {{page}}</span></li>
        
        {{#if hasNextPage}}
        <li class="page-item"><a class="page-link" href="{{nextLink}}">Siguiente</a></li>
        {{/if}}
    </ul>
</nav>
{{/if}}

<script>
document.addEventListener('DOMContentLoaded', function() {
    const forms = document.querySelectorAll('.add-to-cart-form');
    
    forms.forEach(form => {
        form.addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const quantityInput = this.querySelector('.quantity-input');
            const quantity = parseInt(quantityInput.value) || 1;
            const productId = quantityInput.getAttribute('data-product-id');
            const cartId = "{{cartId}}";
            
            if (quantity < 1) {
                alert('La cantidad debe ser al menos 1');
                return;
            }
            
            const maxStock = parseInt(quantityInput.getAttribute('max'));
            if (quantity > maxStock) {
                alert(`Solo hay ${maxStock} unidades disponibles`);
                quantityInput.value = maxStock;
                return;
            }
            
            try {
                const response = await fetch(`/api/carts/${cartId}/products/${productId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ quantity: quantity })
                });
                
                if (response.redirected) {
                    window.location.href = response.url;
                } else {
                    const result = await response.json();
                    if (result.status === 'success') {
                        window.location.href = `/carts/${result.payload._id}`;
                    } else {
                        alert('Error: ' + result.message);
                    }
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error al agregar producto al carrito');
            }
        });
    });
});
</script>
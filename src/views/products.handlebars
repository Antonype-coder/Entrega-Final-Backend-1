<h1 class="mb-3">Productos</h1>
<div class="row">
  {{#each products}}
    <div class="col-md-3 mb-3">
      <div class="card h-100">
        <img src="{{this.thumbnail}}" class="card-img-top" alt="{{this.title}}">
        <div class="card-body">
          <h5 class="card-title">{{this.title}}</h5>
          <p class="card-text">${{this.price}}</p>
          <a href="/products/{{this._id}}" class="btn btn-primary btn-sm">Ver</a>
          <form action="/api/carts/{{../cartId}}/products/{{this._id}}" method="POST" class="mt-3">
            <input type="number" name="quantity" value="1" min="1" class="form-control mb-1">
            <button type="submit" class="btn btn-warning btn-sm w-100">Agregar</button>
          </form>
        </div>
      </div>
    </div>
  {{/each}}
</div>

{{#if totalPages}}
<nav>
  <ul class="pagination">
    {{#if hasPrevPage}}
    <li class="page-item"><a class="page-link" href="{{prevLink}}">Anterior</a></li>
    {{/if}}
    <li class="page-item disabled"><span class="page-link">Página {{page}} de {{totalPages}}</span></li>
    {{#if hasNextPage}}
    <li class="page-item"><a class="page-link" href="{{nextLink}}">Siguiente</a></li>
    {{/if}}
  </ul>
</nav>
{{/if}}
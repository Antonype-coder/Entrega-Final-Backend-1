<div class="row">
    <div class="col-md-6">
        <img src="{{product.thumbnail}}" class="img-fluid rounded" alt="{{product.title}}">
    </div>
    <div class="col-md-6">
        <h2>{{product.title}}</h2>
        <p class="text-muted">{{product.description}}</p>
        <h4 class="text-primary">${{product.price}}</h4>
        <p><strong>Categoría:</strong> {{product.category}}</p>
        <p><strong>Stock disponible:</strong> {{product.stock}} unidades</p>
        
        {{#if product.status}}
        <form id="addToCartForm" class="mb-3">
            <div class="input-group" style="max-width: 250px;">
                <input type="number" id="quantity" name="quantity" value="1" min="1" max="{{product.stock}}" 
                       class="form-control">
                <button class="btn btn-success" type="submit">Agregar al Carrito</button>
            </div>
        </form>
        {{else}}
        <div class="alert alert-warning">Producto no disponible</div>
        {{/if}}
        
        <a href="/products" class="btn btn-secondary">Volver a Productos</a>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('addToCartForm');
    const quantityInput = document.getElementById('quantity');
    
    if (form) {
        form.addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const quantity = parseInt(quantityInput.value) || 1;
            const productId = "{{product._id}}";
            const cartId = "{{cartId}}";
            
            if (quantity < 1) {
                alert('La cantidad debe ser al menos 1');
                return;
            }
            
            const maxStock = parseInt(quantityInput.getAttribute('max'));
            if (quantity > maxStock) {
                alert(`Solo hay ${maxStock} unidades disponibles`);
                quantityInput.value = maxStock;
                return;
            }
            
            try {
                const response = await fetch(`/api/carts/${cartId}/products/${productId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ quantity: quantity })
                });
                
                if (response.redirected) {
                    window.location.href = response.url;
                } else {
                    const result = await response.json();
                    if (result.status === 'success') {
                        window.location.href = `/carts/${result.payload._id}`;
                    } else {
                        alert('Error: ' + result.message);
                    }
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error al agregar producto al carrito');
            }
        });
    }
    
    if (quantityInput) {
        quantityInput.addEventListener('change', function() {
            const maxStock = parseInt(this.getAttribute('max'));
            const currentValue = parseInt(this.value);
            
            if (currentValue > maxStock) {
                this.value = maxStock;
                alert(`Solo hay ${maxStock} unidades disponibles`);
            }
            
            if (currentValue < 1) {
                this.value = 1;
            }
        });
    }
});
</script>